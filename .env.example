# Environment variables read by src/main/resources/application.properties.
# Copy to .env (gitignored) for `docker run --env-file .env`, or set them in your hosting
# provider / GitHub environment. Never commit real values.
#
# Local development alternative: put the same settings, using their Spring property names
# (e.g. spring.datasource.password=...), in application-local.properties next to pom.xml.

# --- Server ---
PORT=8080

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/gmc_db
DB_USERNAME=root
DB_PASSWORD=change-me
# update (dev/staging) or validate (production with migrations)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# --- Security ---
# Base64, at least 256 bits: openssl rand -base64 48
JWT_SECRET=change-me
REFRESH_TOKEN_DAYS=7
# Comma-free single origin of the frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
# true wherever the site is served over HTTPS
COOKIE_SECURE=false

# --- App ---
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads/
PASSWORD_RESET_TOKEN_MINUTES=30

# --- Email (leave SPRING_MAIL_HOST unset to log emails instead of sending them) ---
SPRING_MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=app-password
MAIL_FROM=you@example.com

# --- Checkout pricing ---
CHECKOUT_TAX_RATE=0.15
CHECKOUT_SHIPPING_FEE=1200
CHECKOUT_FREE_SHIPPING_THRESHOLD=0
CHECKOUT_UNPAID_ORDER_EXPIRY_MINUTES=60

# --- Stripe (empty = card payments hidden) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=lkr
